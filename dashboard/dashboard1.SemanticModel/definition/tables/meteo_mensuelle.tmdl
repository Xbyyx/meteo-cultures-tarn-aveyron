table meteo_mensuelle
	lineageTag: 784cc512-7e2c-47ee-a5a4-b4ff1c1a045a

	measure 'Pluie (mm)' = AVERAGEX ( VALUES ( Departement[code] ), CALCULATE ( SUM ( meteo_mensuelle[pluie_mm_moyenne_station] ) ) )
		formatString: #,0
		lineageTag: 545154dc-1da9-533f-806a-6bc64507da77

	measure 'Tmax moyenne (°C)' = AVERAGE ( meteo_mensuelle[tmax_moyenne] )
